# Zyphe GTM Command Center — environment variables
# Copy to .env.local and fill. Server-only; never expose in the client bundle.

# Core
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Auth (Google, restrict to @zyphe.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAIL_DOMAIN="zyphe.com"

# AI brain
ANTHROPIC_API_KEY=""
CLAUDE_MODEL_PRIMARY="claude-opus-5"       # accuracy-critical drafting
CLAUDE_MODEL_CHEAP="claude-sonnet-5"       # ranking / summaries

# Integrations
HUBSPOT_TOKEN=""
AMPLEMARKET_API_KEY=""
SMARTLEAD_API_KEY=""
CLAY_API_KEY=""
SLACK_BOT_TOKEN=""
SLACK_DM_CHANNEL=""                         # Edo's DM/channel for the morning brief
GOOGLE_WORKSPACE_REFRESH_TOKEN=""           # Calendar/Gmail/Drive (or per-user OAuth)
GRANOLA_API_KEY=""                          # optional

# Background jobs
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Feature flags
FEATURE_WRITEBACK="true"                   # true only once HubSpot edit is granted
MOCK_INTEGRATIONS="true"                    # true = run on seeded fixtures, no keys needed

# Ops
FOLLOWUP_DARK_DAYS="7"                       # Follow-up Guardian threshold
TIMEZONE="Europe/Rome"
PRIMARY_DOMAIN="zyphe.com"                   # never send cold from this
